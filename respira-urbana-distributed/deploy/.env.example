# Copie para deploy/.env (cp deploy/.env.example deploy/.env), preencha e proteja: chmod 600 deploy/.env
# Nunca versione este arquivo (o .gitignore da raiz ja o ignora).

# Dominio que aponta para o IP da VPS (registro A). O Caddy emite o HTTPS sozinho.
# Sem dominio: use ":80" (HTTP por IP, so para testar).
DOMAIN=respira.exemplo.com

# Mesmas chaves do .env de desenvolvimento
OPENWEATHER_API_KEY=
TOMTOM_API_KEY=
# Vazio = padrao do projeto (GFW/Hansen)
DEFORESTATION_TILES_URL=
# Alertas recentes de desmatamento (GFW Data API). Gere com: node scripts/gfw-key.mjs
GFW_API_KEY=
GFW_ORIGIN=http://localhost

# Push (Firebase). Gere com: node scripts/fcm-env.mjs chave-da-conta-de-servico.json
FCM_SERVICE_ACCOUNT_B64=

# Monitoramento (vazio = 6 capitais brasileiras). Formato: Nome:lat:lon;Nome:lat:lon
MONITOR_LOCATIONS=
MONITOR_INTERVAL_SECONDS=900
AQI_ALERT_THRESHOLD=80
