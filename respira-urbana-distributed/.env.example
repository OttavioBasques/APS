# Modelo de configuracao. Copie para ".env" (cp .env.example .env) e preencha.
# O docker-compose le o arquivo ".env" automaticamente.

# --- Camadas de calor do mapa (OpenWeatherMap) ---
# Chave gratuita: https://home.openweathermap.org/users/sign_up (plano "Free").
OPENWEATHER_API_KEY=cole_sua_chave_aqui

# --- Transito em tempo real (TomTom) ---
# Chave gratuita: https://developer.tomtom.com (confira os limites do plano).
# Deixe vazio para desabilitar a camada de transito.
TOMTOM_API_KEY=

# --- Desmatamento (Global Forest Watch) ---
# URL dos tiles XYZ. Vazio = padrao do projeto (perda de cobertura arborea,
# GFW/Hansen v1.8, 2001-2022). Para versoes mais novas, troque a versao na URL:
# https://tiles.globalforestwatch.org/umd_tree_cover_loss/<versao>/tcd_30/{z}/{x}/{y}.png
DEFORESTATION_TILES_URL=
# Alertas de desmatamento recentes (pinos no mapa, checagem de mananciais e alertas automaticos).
# Chave gratuita da GFW Data API. Para gerar: node scripts/gfw-key.mjs   (passo a passo no README)
# Vazio = o resto funciona; so os alertas recentes de desmatamento ficam desativados.
GFW_API_KEY=
# Dominio cadastrado na chave (sem porta). So mude se voce cadastrou outro dominio ao criar a chave.
GFW_ORIGIN=http://localhost

# --- Notificacoes push (Firebase Cloud Messaging) ---
# Conta de servico do Firebase em base64 numa linha so (gere com: node scripts/fcm-env.mjs sua-chave.json).
# Vazio = push desativado (o resto funciona). Passo a passo: mobile/README.md
FCM_SERVICE_ACCOUNT_B64=

# --- Monitoramento e alertas ---
# Locais vigiados automaticamente (alertas de ar, alagamento, inversao termica e transito).
# Formato: Nome:latitude:longitude;Nome:latitude:longitude  (vazio = 6 capitais brasileiras)
MONITOR_LOCATIONS=
# Intervalo entre verificacoes (segundos).
MONITOR_INTERVAL_SECONDS=900

# --- Usadas apenas ao rodar os servicos SEM docker-compose ---
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=300
AQI_ALERT_THRESHOLD=80
# Alertas de desmatamento: minimo de alertas confirmados (30 dias) para avisar.
MANANCIAL_ALERT_MIN=5     # dentro de mananciais/areas protegidas perto do local monitorado
FOREST_ALERT_MIN=50       # num raio de 10 km
